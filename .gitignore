!/outputs/public/**

# Large data/export formats
*.parquet
*.jsonl
*.ndjson
*.inspect.*

# Local run logs
run_log*.txt
*.log
logs/

# Generated research-process figures, animations, and frame sequences are
# review inputs, not release artifacts. Curated copies belong in outputs/public.
/visuals/research_process/
/deliverables/driver_1003/**/research_process_figures/

# External drive mounts or copied mount contents
/Volumes/
Volumes/
KINGSTON/
/Volumes/KINGSTON/

# Large generated delivery bundle (prepared locally for Google Drive)
/deliverables/google_drive_phase2/

# Driver 1003 HTML research deliverables are intentionally committed.
# Keep any accidental data/debug artifacts out of that curated tree.
/deliverables/driver_1003/**/*.csv
/deliverables/driver_1003/**/*.parquet
/deliverables/driver_1003/**/*.jsonl
/deliverables/driver_1003/**/debug/
/deliverables/driver_1003/**/legacy_selected_maps/

# Restricted historical Driver 1003 products retain detailed routes, timestamps,
# or endpoint geometry. Keep local copies for approved research use only. The
# reviewed, public-safe report and map live in outputs/public/ instead.
/deliverables/driver_1003/graph_comparisons/
/deliverables/driver_1003/monthly_graphs/
/deliverables/driver_1003/timeline/
/deliverables/driver_1003/route_evolution_animation/
