diff --git a/CMakeLists.txt b/CMakeLists.txt
index 1e2aeb3..26967f8 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -27,8 +27,8 @@ project(fmm)
 
 set(CMAKE_BUILD_TYPE "Release")
 set(CMAKE_CXX_FLAGS "-O3 -DSPDLOG_ACTIVE_LEVEL=SPDLOG_LEVEL_TRACE")
-set(CMAKE_CXX_STANDARD 11)
-set(CMAKE_RUNTIME_OUTPUT_DIRECTORY "${CMAKE_CURRENT_SOURCE_DIR}/build")
+set(CMAKE_CXX_STANDARD 17)
+set(CMAKE_RUNTIME_OUTPUT_DIRECTORY "${CMAKE_BINARY_DIR}/bin")
 
 list(APPEND CMAKE_MODULE_PATH "${CMAKE_SOURCE_DIR}/cmake")
 
@@ -69,6 +69,19 @@ find_package(OpenMP REQUIRED)
 if(OPENMP_FOUND)
   set(CMAKE_C_FLAGS "${CMAKE_C_FLAGS} ${OpenMP_C_FLAGS}")
   set(CMAKE_CXX_FLAGS "${CMAKE_CXX_FLAGS} ${OpenMP_CXX_FLAGS}")
+  find_path(OpenMP_CXX_INCLUDE_DIR omp.h
+    HINTS ${OpenMP_CXX_INCLUDE_DIRS}
+          /opt/homebrew/opt/libomp/include
+          /usr/local/opt/libomp/include)
+  if(OpenMP_CXX_INCLUDE_DIR)
+    include_directories(${OpenMP_CXX_INCLUDE_DIR})
+  endif()
+  find_library(OpenMP_CXX_LIBRARY omp
+    HINTS /opt/homebrew/opt/libomp/lib
+          /usr/local/opt/libomp/lib)
+  if(OpenMP_CXX_LIBRARY)
+    set(OpenMP_CXX_LIBRARIES ${OpenMP_CXX_LIBRARY})
+  endif()
   message(STATUS "OpenMP_HEADERS found at ${OpenMP_CXX_INCLUDE_DIRS}")
   message(STATUS "OpenMP_CXX_LIBRARIES found at ${OpenMP_CXX_LIBRARIES}")
 endif()
diff --git a/python/CMakeLists.txt b/python/CMakeLists.txt
